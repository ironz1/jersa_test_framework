{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "admin-discount-code.json",
  "title": "Utworzony kod rabatowy: POST /api/admin/discount-codes (200)",
  "description": "Spisane z odpowiedzi z 2026-11-19. Definicja kodu używana też przez listę kodów.",
  "type": "object",
  "required": [
    "code"
  ],
  "properties": {
    "code": {
      "$ref": "#/$defs/discountCode"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "discountCode": {
      "type": "object",
      "required": [
        "id",
        "code",
        "kind",
        "value",
        "endsOn",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "percent",
            "amount"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "endsOn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
