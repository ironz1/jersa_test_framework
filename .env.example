# Skopiuj do .env (nie commitujemy). Czytają go docker compose i (od Etapu 2) pytest.

# Ścieżka do lokalnego klonu sklepu — kontekst budowania obrazu (względna od repo testów albo absolutna).
STOREFRONT_PATH=../../Documents/Repos/jersa-storefront

# Hasło operatora /admin w kontenerze sklepu.
ADMIN_PASSWORD=dev-admin

# Porty na hoście (tylko 127.0.0.1). 3000 zostaje wolny dla `next dev`.
APP_PORT=3100
DB_PORT=5432

# Cel testów. Docker lokalnie / w CI: http://localhost:3100; STG: https://jersa-storefront.vercel.app
BASE_URL=http://localhost:3100

# Baza widziana z hosta (testy DB). Kontenery łączą się przez nazwę usługi: postgres:5432.
DATABASE_URL=postgresql://jersa:jersa@localhost:5432/jersa
